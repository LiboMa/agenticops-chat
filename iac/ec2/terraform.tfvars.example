# === Required ===
region         = "ap-southeast-1"
admin_password = "CHANGE_ME"
acm_cert_arn   = "arn:aws:acm:ap-southeast-1:ACCOUNT_ID:certificate/CERT_ID"

# === Optional (uncomment to customize) ===
# project_name       = "agenticops"
# image_tag          = "latest"
# instance_type      = "c5.xlarge"
# bedrock_region     = "us-east-1"
# bedrock_model      = "global.anthropic.claude-sonnet-4-6"

# === Network: internal (VPC) or internet-facing (public) ===
# alb_internal = false  # true = only accessible within VPC

# === Bring Your Own (uncomment if using existing infra) ===
# vpc_id             = "vpc-0abc123def456"
# public_subnet_ids  = ["subnet-aaa", "subnet-bbb"]
# private_subnet_ids = ["subnet-ccc", "subnet-ddd"]

# === Custom Domain (optional, enables auto-cert if no acm_cert_arn) ===
# domain_name     = "ops.example.com"
# route53_zone_id = "Z1234567890ABC"

# === SSH (disabled by default) ===
# ssh_enabled         = true
# ssh_public_key_path = "~/.ssh/id_rsa.pub"

# === Database (default: sqlite) ===
# db_backend = "rds"
