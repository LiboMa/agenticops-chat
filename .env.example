# AgenticAIOps Configuration
# Copy this file to .env and configure your settings
# Or run `aiops init` for an interactive setup wizard.

# Database (SQLite by default)
AIOPS_DATABASE_URL=sqlite:///data/agenticops.db

# AWS Bedrock Configuration — Tiered Models
AIOPS_BEDROCK_REGION=us-east-1
AIOPS_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AIOPS_BEDROCK_MODEL_ID_CHEAP=global.anthropic.claude-haiku-4-5-20251001-v1:0
AIOPS_BEDROCK_MODEL_ID_STRONG=global.anthropic.claude-opus-4-6-v1

# Monitoring Settings
AIOPS_DEFAULT_METRICS_PERIOD=300
AIOPS_ANOMALY_DETECTION_WINDOW=3600

# Executor (Fix Plan Execution)
AIOPS_EXECUTOR_ENABLED=true

# Auto-Fix Pipeline
AIOPS_AUTO_RCA_ENABLED=true
AIOPS_AUTO_FIX_ENABLED=true
AIOPS_NOTIFICATIONS_ENABLED=true

# Alert Pipeline Mode: event_driven, channel_driven, or both
AIOPS_ALERT_PIPELINE_MODE=both

# Directories
AIOPS_DATA_DIR=data
AIOPS_REPORTS_DIR=data/reports
AIOPS_KNOWLEDGE_BASE_DIR=data/knowledge_base

# Report Storage (local or s3)
AIOPS_REPORT_STORAGE=local
# AIOPS_REPORT_S3_BUCKET=my-aiops-reports
# AIOPS_REPORT_S3_PREFIX=reports/
# AIOPS_REPORT_S3_REGION=us-east-1

# Deployment Profile (local or cloud)
# AIOPS_DEPLOYMENT_PROFILE=local

# Vector Storage (sqlite, rds, or s3)
# AIOPS_VECTOR_STORAGE=sqlite
# AIOPS_VECTOR_RDS_URL=postgresql+psycopg2://user:pass@host:5432/agenticops
# AIOPS_VECTOR_S3_BUCKET=my-aiops-vectors
# AIOPS_VECTOR_S3_PREFIX=vectors/
# AIOPS_VECTOR_S3_REGION=us-east-1

# KB File Storage (local or s3)
# AIOPS_KB_STORAGE=local
# AIOPS_KB_S3_BUCKET=my-aiops-kb
# AIOPS_KB_S3_PREFIX=knowledge_base/
# AIOPS_KB_S3_REGION=us-east-1
